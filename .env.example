# Copy to .env and edit. Every setting is optional.

# Port the app listens on.
PORT=3000

# Ollama model for Activities 1 and 2: writing, poetry and colours.
# Run `ollama pull <model>` first.
MODEL=mistral-small:24b

# Ollama model for Activity 3 (Temp Check), which needs answers that spread out
# as temperature rises. Set it equal to MODEL to use one model for everything.
TEMP_MODEL=llama3.2

# Where Ollama is listening.
OLLAMA_URL=http://127.0.0.1:11434

# Shown instead of the detected address, e.g. a reserved IP.
# PUBLIC_URL=http://192.168.100.100:3000

# How many requests run at once. Match OLLAMA_NUM_PARALLEL.
MAX_PARALLEL=4

# Context window per request. Small keeps memory use low; leave it unless needed.
# NUM_CTX=4096

# Optional link shown on the thank-you screen.
# GOOGLE_FORM_URL=
